<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WssArtifactDir Condition="'$(WSS_ARTIFACT_DIR)' == ''">$(MSBuildProjectDirectory)\..\SubModules\HFI_WSS_Csharp_Implementation\lib</WssArtifactDir>
    <WssArtifactDir Condition="'$(WSS_ARTIFACT_DIR)' != ''">$(WSS_ARTIFACT_DIR)</WssArtifactDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="WSS_Core_Interface">
      <HintPath>$(WssArtifactDir)\WSS_Core_Interface.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
